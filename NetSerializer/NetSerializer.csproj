<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>A very fast and minimal serializer</Description>
    <Company>Space Wizards Federation</Company>
    <Copyright>Copyright © 2012-2019 Tomi Valkeinen; Copyright © Space Wizards Federation contributors</Copyright>
    <Version>0.0.0-dev</Version>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <Authors>Tomi Valkeinen;$(Company)</Authors>
    <PackageTags>Serializer</PackageTags>
    <RepositoryUrl>https://github.com/space-wizards/SpaceWizards.NetSerializer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageId>SpaceWizards.NetSerializer</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>SpaceWizards.NetSerializer</AssemblyName>

    <NoWarn>SYSLIB0050</NoWarn> <!-- Mute warnings about BinaryFormatter. -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
